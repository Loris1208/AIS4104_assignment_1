<?xml version="1.0" encoding="UTF-8"?>
<optimization>
    <preset name="Gradient descent" scenario="curve"/>
    <function name="(x - 1)^2"/>
    <range x_lower="-2" x_upper="4"/>
    <seed x="3.5"/>
    <solve limit="200" step="0" form="minimum" method="gradient_descent" step_length="0.1"/>
</optimization>
