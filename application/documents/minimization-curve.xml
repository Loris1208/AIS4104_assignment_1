<?xml version="1.0" encoding="UTF-8"?>
<optimization>
    <preset name="Minimization: curve" scenario="curve"/>
    <function name="x^4 - 3x^2 + x"/>
    <range x_lower="-2.5" x_upper="2.5"/>
    <seed x="2"/>
    <solve limit="500" step="0" form="minimum" method="gradient_descent" step_length="0.05"/>
</optimization>
