cmake_minimum_required(VERSION 3.28)

set(executables "")
set(after_separator FALSE)
math(EXPR last_argument "${CMAKE_ARGC} - 1")
foreach (index RANGE 1 ${last_argument})
    if (after_separator)
        list(APPEND executables "${CMAKE_ARGV${index}}")
    elseif (CMAKE_ARGV${index} STREQUAL "--")
        set(after_separator TRUE)
    endif ()
endforeach ()

if (executables STREQUAL "")
    message(FATAL_ERROR "no test executable was named after --")
endif ()

set(failures "")
foreach (executable IN LISTS executables)
    execute_process(COMMAND "${executable}" --list-tests --colour-mode none "[.],*" OUTPUT_VARIABLE listing RESULT_VARIABLE status)
    if (NOT status EQUAL 0)
        message(FATAL_ERROR "${executable} --list-tests exited with status ${status}")
    endif ()

    string(REPLACE "\r" "" listing "${listing}")
    set(listing "\n${listing}\n")
    string(REGEX REPLACE "\n  [^ \n]" "\n  x" marked "${listing}")
    string(REGEX MATCHALL "\n  x" name_lines "${marked}")
    list(LENGTH name_lines name_line_count)

    if (NOT listing MATCHES "\n([0-9]+) matching test cases?\n")
        message(FATAL_ERROR "${executable} --list-tests printed no matching test case count")
    endif ()
    set(test_case_count "${CMAKE_MATCH_1}")

    message(STATUS "${executable}: ${test_case_count} test cases, ${name_line_count} name lines")
    if (NOT name_line_count EQUAL test_case_count)
        string(APPEND failures "${executable} lists ${test_case_count} test cases on ${name_line_count} lines at the name indent:${listing}")
    endif ()
endforeach ()

if (NOT failures STREQUAL "")
    message(FATAL_ERROR "${failures}")
endif ()
